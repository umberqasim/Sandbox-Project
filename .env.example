# Copy to .env (never commit .env) and set a fresh random key:
#   openssl rand -hex 16
API_KEY=change-me

# Optional: use 1 evaluation at a time on a 4 GB machine; raise to 2 on larger hosts.
# WORKER_CONCURRENCY=1

# Memory cap for each Dockerfile build step. 1024 MB is the conservative 4 GB default.
# Raise only on a larger host if a legitimate dependency build needs more memory.
# MAX_BUILD_MEMORY_MB=1024

# Optional
# Comma-separated dashboard origins allowed to call the API (default: any origin)
# CORS_ORIGINS=http://localhost:5173
# Git hosts submissions may be cloned from
# ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org

# Optional advisory AI review (written by a language model on Groq; never changes scores).
# Leave GROQ_API_KEY empty to keep the feature off. See README.md ("AI review").
# GROQ_API_KEY=
# Default model: openai/gpt-oss-120b. Check console.groq.com/docs/models for what your key may use.
# AI_REVIEW_MODEL=openai/gpt-oss-120b
# By default only evaluation results are sent, never source code. true = also send a few redacted snippets.
# AI_REVIEW_SEND_CODE=false

# Optional Ezitech Portal callback: when a caller passes "callback_url", the worker POSTs a JSON summary there
# once the evaluation has finished (see docs/api.md, "Portal callback").
# Secret used to sign each call (X-Sandbox-Signature). Use a long random value: openssl rand -hex 32
# CALLBACK_SECRET=
# Only these callback hosts are accepted (comma-separated). Recommended in production.
# CALLBACK_ALLOWED_HOSTS=portal.example.com
# Local testing only: allow http:// and private/localhost callback addresses. Never enable in production.
# CALLBACK_ALLOW_INSECURE=0
# CALLBACK_ALLOW_PRIVATE=0
